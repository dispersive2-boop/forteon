# ==========================================================================
# ForteOn — переменные окружения
# Локальные порты: web 8080, api 8081  (3000 занят AI-агентом, 80/443 — Caddy)
# Production: https://forteon.pro через Caddy
# ==========================================================================

# --- Backend ---
FORTEON_DEBUG=true
# PostgreSQL (docker-compose подставит свой DSN):
# FORTEON_DATABASE_URL=postgresql+psycopg://forteon:forteon@postgres:5432/forteon
FORTEON_DATABASE_URL=sqlite:///./data/forteon.db
FORTEON_SECRET_KEY=change-me-to-a-long-random-string
FORTEON_ACCESS_TTL=60
FORTEON_REFRESH_TTL_DAYS=30
FORTEON_COOKIE_SECURE=false
# В production за Caddy: https://forteon.pro
FORTEON_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://forteon.pro,https://www.forteon.pro
FORTEON_TIMEZONE=Asia/Yekaterinburg

# Bootstrap-учётки. Пароли НЕ имеют значений по умолчанию: если оставить
# пустыми, при первом старте будут сгенерированы случайные и записаны
# в backend/data/bootstrap-credentials.txt (в .gitignore, права 600).
FORTEON_ADMIN_EMAIL=admin@forteon.local
FORTEON_ADMIN_PASSWORD=
FORTEON_MANAGER_EMAIL=manager@forteon.local
FORTEON_MANAGER_PASSWORD=
FORTEON_DEMO_SEED=true
# Каталог с исходным XLSX отчёта (по умолчанию — рабочий стол пользователя)
# FORTEON_SEED_DIR=C:\Users\Public\Documents

# --- AI Extractor: RouterAI (OpenAI-совместимый, https://routerai.ru/api/v1) ---
# Без ключа работает детерминированный локальный экстрактор
FORTEON_AI_API_KEY=
FORTEON_AI_BASE_URL=https://routerai.ru/api/v1
FORTEON_AI_MODEL=z-ai/glm-5.3-flashx-legal
FORTEON_AI_ENABLED=true
FORTEON_AI_TIMEOUT=60
FORTEON_AI_MAX_TOKENS=900
FORTEON_AI_RETRIES=2
FORTEON_AI_TEMPERATURE=0.1
# Если провайдер не поддерживает response_format=json_object — поставить false
FORTEON_AI_JSON_MODE=true

# --- Распознавание аудиочерновиков (совместимый с OpenAI API) ---
FORTEON_STT_BASE_URL=
FORTEON_STT_API_KEY=
FORTEON_STT_MODEL=whisper-1

# --- Фоновая проверка новых заметок (раз в минуту) ---
FORTEON_NOTE_WATCHER=true
FORTEON_NOTE_WATCHER_INTERVAL=60
FORTEON_NOTE_WATCHER_BATCH=10

# --- Файлы ---
FORTEON_STORAGE_DIR=./data/storage
FORTEON_REPORTS_DIR=./data/reports
FORTEON_MAX_UPLOAD_MB=25

# --- Порты ---
FORTEON_WEB_PORT=8080
FORTEON_API_PORT=8081
POSTGRES_PASSWORD=forteon

# Comma-separated origins for outbound HTTPS requests to Zimbra.
FORTEON_ZIMBRA_ORIGINS=
# Generate a persistent Fernet key for encrypting email credentials at rest.
FORTEON_MAIL_SECRET=
