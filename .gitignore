# зависимости
frontend/node_modules/
backend/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# сборка
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo

# секреты — НИКОГДА не коммитим
.env
.env.local
.env.*.local
backend/.env

# база и данные
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite3*
backend/data/storage/
backend/data/reports/
backend/data/seed/
backend/uploads/
backend/reports_out/
# пароли bootstrap-учёток, сгенерированные при первом старте
backend/data/bootstrap-credentials.txt

# логи и временные
*.log
_caddy_status.txt

# служебные скрипты отладки (не часть продукта), кроме __init__.py
/_*.py
/backend/_*.py
/backend/_*.txt
/backend/_*.html
